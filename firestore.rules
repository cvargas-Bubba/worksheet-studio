rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fichas: cualquiera las lee; solo la profesora guarda o borra
    match /fichas/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "CORREO_DE_LA_PROFESORA";
    }
  }
}
